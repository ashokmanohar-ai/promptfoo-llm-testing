# User-friendly Azure OpenAI settings used by this repository.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_HOST=your-resource-name.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=

# Optional: separate deployments for controlled model comparison.
AZURE_OPENAI_DEPLOYMENT_MODEL_A=
AZURE_OPENAI_DEPLOYMENT_MODEL_B=

# Optional: use dedicated judge and embedding deployments.
AZURE_OPENAI_JUDGE_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=

# Native Promptfoo Azure aliases. Set these to the same API key and host.
# Promptfoo 0.122.0 documents AZURE_API_KEY and AZURE_API_HOST natively.
AZURE_API_KEY=
AZURE_API_HOST=your-resource-name.openai.azure.com
AZURE_DEPLOYMENT_NAME=

# Example quality gates. Calibrate with your own golden dataset.
MINIMUM_PASS_RATE=0.90
MAXIMUM_SECURITY_FAILURES=0
MAXIMUM_CRITICAL_VULNERABILITIES=0
MAXIMUM_HIGH_VULNERABILITIES=0
MAXIMUM_AVERAGE_LATENCY_MS=8000
MAXIMUM_AVERAGE_COST_USD=0.05
